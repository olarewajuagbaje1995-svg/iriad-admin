# IRIAD Operations Portal — environment variables
# Copy this file to .env and fill in real values before running locally.
# .env is gitignored and must never contain real secrets in version control.
# .env.example contains placeholders only — never real secrets.

# Supabase project (browser-safe: URL + publishable key only)
VITE_SUPABASE_URL=https://rvjpdfudghwqcxldrkri.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UeYt9GmZmC6YfS9m5XV4bQ_mDlzW-0M

# Server-side only (backend/Edge Functions). NEVER expose with a VITE_ prefix.
SUPABASE_URL=https://rvjpdfudghwqcxldrkri.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_NEW_ROTATED_SECRET_KEY

# Optional server-side services
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:5173

# n8n webhook URLs (frontend-safe; used by KnowledgeBasePage, ChatbotPage, AnnouncementsPage)
VITE_N8N_ANNOUNCEMENT_WEBHOOK_URL=https://olarewajuagbaje-n8n-automation-hub.hf.space/webhook/announcement
VITE_N8N_KNOWLEDGE_INGEST_WEBHOOK_URL=https://olarewajuagbaje-n8n-automation-hub.hf.space/webhook/knowledge-ingest
VITE_N8N_KNOWLEDGE_CHAT_WEBHOOK_URL=https://olarewajuagbaje-n8n-automation-hub.hf.space/webhook/knowledge-chat

# NVIDIA API (AI model provider for knowledge assistant / RAG). Configure locally in .env only.
NVIDIA_API_KEY=REPLACE_WITH_NVIDIA_API_KEY

# Demo authentication mode. "true" = email/password only, independent of Supabase.
# Any other value (or removing the line) = real Supabase auth; requires valid keys.
VITE_DEMO_MODE=false
