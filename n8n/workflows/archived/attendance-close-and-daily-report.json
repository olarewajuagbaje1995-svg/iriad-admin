{
  "name": "Attendance Close and Daily Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "cron": {
            "expression": "5 9 * * 1-5"
          }
        },
        "timezone": "Africa/Lagos"
      },
      "name": "Daily 09:05 Lagos Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "id": "attendance-close-trigger"
    },
    {
      "parameters": {
        "operation": "update",
        "table": "attendance_sessions",
        "columns": {
          "morning_closed_at": "={{ $now.toISOString() }}",
          "updated_at": "={{ $now.toISOString() }}"
        },
        "filter": {
          "column": "work_date",
          "value": "={{ $now.startOfDay().toISOString().split('T')[0] }}",
          "operator": "equal"
        },
        "options": {}
      },
      "name": "Close Check-in Session",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "id": "attendance-close-session"
    },
    {
      "parameters": {
        "operation": "select",
        "table": "attendance",
        "columns": "*, profiles(full_name, email)",
        "filter": {
          "column": "created_at",
          "operator": "gte",
          "value": "={{ $now.startOfDay().subtract(1, 'day').toISOString() }}"
        },
        "options": {}
      },
      "name": "Fetch Yesterday Attendance",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [680, 300],
      "id": "attendance-close-fetch"
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "generated_reports",
        "columns": {
          "report_type": "daily",
          "period_start": "={{ $now.startOfDay().subtract(1, 'day').format('YYYY-MM-DD') }}",
          "period_end": "={{ $now.startOfDay().subtract(1, 'day').format('YYYY-MM-DD') }}",
          "organisation_id": "{{ $env.IRIAD_ORGANISATION_ID }}",
          "content": "={{ JSON.stringify($json) }}",
          "generated_at": "={{ $now.toISOString() }}"
        },
        "options": {}
      },
      "name": "Save Daily Snapshot",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 300],
      "id": "attendance-close-save"
    }
  ],
  "connections": {
    "Daily 09:05 Lagos Trigger": {
      "main": [[{ "node": "Close Check-in Window", "type": "main", "index": 0 }]]
    },
    "Close Check-in Session": {
      "main": [[{ "node": "Fetch Yesterday Attendance", "type": "main", "index": 0 }]]
    },
    "Fetch Yesterday Attendance": {
      "main": [[{ "node": "Save Daily Snapshot", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "id": "attendance-close-and-daily-report",
  "meta": { "instanceId": 0, "templateCredsSetupCompleted": true }
}
