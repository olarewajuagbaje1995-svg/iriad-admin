{
  "name": "Weekly Management Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "intervalHour": 24
            }
          ]
        },
        "options": {}
      },
      "name": "Weekly Friday 16:00 Lagos Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "id": "weekly-report-trigger"
    },
    {
      "parameters": {
        "operation": "select",
        "table": "weekly_reports",
        "columns": "*, profiles(full_name, email)",
        "filter": {
          "column": "created_at",
          "operator": "gte",
          "value": "={{ $now.subtract(7, 'day').startOf('day').toISOString() }}"
        },
        "options": {}
      },
      "name": "Fetch Weekly Reports",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [460, 300],
      "id": "weekly-report-fetch"
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "notifications",
        "columns": {
          "title": "Weekly management report ready",
          "body": "Weekly attendance and report summary compiled for management review.",
          "type": "report",
          "link": "/app/reports",
          "is_read": false,
          "created_at": "={{ $now.toISOString() }}"
        },
        "options": {}
      },
      "name": "Notify Management",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [680, 300],
      "id": "weekly-report-notify"
    }
  ],
  "connections": {
    "Weekly Friday 16:00 Lagos Trigger": {
      "main": [[{ "node": "Fetch Weekly Reports", "type": "main", "index": 0 }]]
    },
    "Fetch Weekly Reports": {
      "main": [[{ "node": "Notify Management", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {},
  "id": "weekly-management-report",
  "meta": { "instanceId": 0, "templateCredsSetupCompleted": true }
}
